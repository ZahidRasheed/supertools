{
  "manifest_version": 3,
  "name": "Supertools",
  "version": "1.1.0",
  "description": "Small Chrome tools. Copy open links, clean the active tab URL, and more.",
  "permissions": ["tabs"],
  "action": {
    "default_title": "Supertools",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
